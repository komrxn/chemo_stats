# Backend Environment Variables Template
# Copy this to .env for local development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:8080

# Secret key for JWT tokens (REQUIRED - generate a secure random string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-me-REQUIRED

# Port (defaults to 8000 locally, $PORT on Render)
PORT=8000

# Debug mode (enables SQL query logging - set to false in production)
DEBUG=true

# Log level
LOG_LEVEL=INFO
